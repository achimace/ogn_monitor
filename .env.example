# ==============================================
# OGN FlightMonitor - Environment Configuration
# ==============================================
# Copy to .env and fill in your values:
#   cp .env.example .env

# Database
DB_USER=ogn_monitor
DB_PASSWORD=CHANGE_ME_secure_password_here
DB_PORT=5432

# JWT Authentication
JWT_SECRET=CHANGE_ME_at_least_64_random_characters_here

# OGN / APRS
OGN_CALLSIGN=OGNMON

# SMTP (optional, for email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Application
BASE_URL=http://localhost
LOG_LEVEL=info

# Tracking
# Flight track for the monitor map: min. seconds between stored points, retention
TRACK_MIN_INTERVAL_S=5
# Max 86400: OGN data usage policy forbids redistributing data older than 24 h
TRACK_RETENTION_S=86400
# Consecutive fast beacons before a takeoff is declared (2 = GPS glitch guard, 1 = legacy)
TAKEOFF_MIN_FAST_BEACONS=2
# Height above ground from the terrain model (elevation_tiles, see DEPLOYMENT.md
# "Geländemodell"). false = airfield elevation everywhere (legacy)
TERRAIN_AGL_ENABLED=true
# Aircraft categories whose beacons the worker drops entirely (rescue helicopters
# hovering over the field, balloons, drones, static obstacles, skydivers). Category
# from the tenant fleet / registry when known, else from the OGN beacon type.
# Valid: glider, tow_plane, motor_glider, powered, ultralight, helicopter,
# paraglider_hangglider, parachute_drop, balloon_airship, uav, static, jet.
# Empty = no filter. Tow planes, powered aircraft, motor gliders and jets stay tracked.
IGNORED_AIRCRAFT_CATEGORIES=helicopter,balloon_airship,uav,static,parachute_drop

# Foreign airfields / visitors (table airports, import: python -m app.tools.import_airports)
# Airports within this radius of every active airfield are kept in memory (also the import default)
AIRPORTS_INDEX_RADIUS_KM=300
# Slow + low within this distance of a known airport = landing there (not an outlanding)
FOREIGN_AIRFIELD_RADIUS_M=2000
# Aircraft airborne within this distance of home that did not start here are shown as
# visitors (0 = Besucher-Erkennung aus)
VISITOR_ZONE_KM=15
# Visitors are only picked up below this height above the airfield
VISITOR_MAX_AGL_M=1500

# VF-Sync (Vereinsflieger integration, optional)
# Activate the worker permanently by adding the profile here, otherwise
# `docker compose up` (and deploy.sh) never starts or rebuilds it:
#   COMPOSE_PROFILES=vfsync
COMPOSE_PROFILES=
# Fernet key for encrypting VF credentials in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VFSYNC_CRED_KEY=
# Allowed VF hosts for vf_base_url (comma separated); https is mandatory
VFSYNC_ALLOWED_HOSTS=www.vereinsflieger.de
# Local testing only: allow http://vfmock:8099 as vf_base_url and start the
# mock with `docker compose --profile vfmock up -d vfmock` (UI on VFMOCK_PORT)
VFSYNC_ALLOW_INSECURE_BASE_URL=false
VFMOCK_PORT=8099
VF_MOCK_USERNAME=mock-user
VF_MOCK_PASSWORD=mock-password
VF_MOCK_APPKEY=mock-appkey
VFSYNC_HEALTH_PORT=8090
VFSYNC_ALERT_NTFY_URL=
VFSYNC_ALERT_EMAIL_TO=
VFSYNC_TIMEZONE=Europe/Berlin

# Scaling
API_WORKERS=4

# Ports
HTTP_PORT=80
HTTPS_PORT=443
