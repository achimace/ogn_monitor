# ==============================================
# OGN FlightMonitor - Environment Configuration
# ==============================================
# Copy to .env and fill in your values:
#   cp .env.example .env

# Database
DB_USER=ogn_monitor
DB_PASSWORD=CHANGE_ME_secure_password_here
DB_PORT=5432

# JWT Authentication
JWT_SECRET=CHANGE_ME_at_least_64_random_characters_here

# OGN / APRS
OGN_CALLSIGN=OGNMON

# SMTP (optional, for email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Application
BASE_URL=http://localhost
LOG_LEVEL=info

# Scaling
API_WORKERS=4

# Ports
HTTP_PORT=80
HTTPS_PORT=443
