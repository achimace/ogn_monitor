# Copy to .deploy.env (gitignored) and fill in your values:
#   cp .deploy.env.example .deploy.env

DEPLOY_HOST=flight-monitor.de
DEPLOY_USER=root
DEPLOY_PATH=/opt/ogn_monitor
DEPLOY_BRANCH=master
HEALTH_URL=https://flight-monitor.de/health

# Optional: GitHub HTTPS credentials for the remote `git pull`.
# Strongly recommended: use a fine-grained Personal Access Token instead of
# a real account password (Settings → Developer settings → Personal access
# tokens → Fine-grained tokens, scoped to this single repo, "Contents: read").
# Leave both empty to use whatever auth the server already has configured
# (e.g. an SSH deploy key).
GIT_USER=achimace
GIT_PASSWORD=
